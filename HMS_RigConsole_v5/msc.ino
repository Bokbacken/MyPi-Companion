// ============================================================
//  msc.ino — USB Mass Storage Class (FAT12 virtual disk)
//
//  The ESP32-S3 exposes a 256 KB FAT12 volume labelled RIGSETUP.
//  On Linux (Pi) it auto-mounts as  /media/<user>/RIGSETUP/
//  Files on the volume:
//    install.sh      — HMS Rig Console installer
//    rig_daemon.py   — the daemon that runs on the Pi
//
//  The disk image is baked in as  msc_image.h  (generated by
//  gen_msc_image.py).  At boot the image is copied to PSRAM so
//  the Pi kernel can write dirty bits / allocation tables without
//  corrupting the flash.  The PSRAM copy is reset on each power
//  cycle, so the "disk" always comes up clean.
//
//  Init order in setup():
//    mscBegin()   ← register MSC interface with TinyUSB
//    hidBegin()   ← register HID  interface + call USB.begin()
//
//  mscBegin() must be called BEFORE hidBegin() so both
//  interfaces are registered before USB.begin() finalises the
//  composite device descriptor.
// ============================================================

#include "USBMSC.h"
#include "msc_image.h"   // generated by gen_msc_image.py

static USBMSC MSC;
static uint8_t  *msc_ram      = nullptr;  // working copy in PSRAM
static uint32_t  msc_img_bytes = 0;       // size of working copy

// ── Callbacks (invoked from TinyUSB task) ─────────────────────
//  Named on_msc_* to avoid clashing with the msc_read_cb /
//  msc_write_cb typedefs declared in USBMSC.h.

static int32_t on_msc_read(uint32_t lba, uint32_t offset,
                            void *buffer, uint32_t bufsize) {
  uint32_t pos = lba * MSC_BLOCK_SIZE + offset;
  memcpy(buffer, msc_ram + pos, bufsize);
  return (int32_t)bufsize;
}

static int32_t on_msc_write(uint32_t lba, uint32_t offset,
                             uint8_t *buffer, uint32_t bufsize) {
  uint32_t pos = lba * MSC_BLOCK_SIZE + offset;
  memcpy(msc_ram + pos, buffer, bufsize);
  return (int32_t)bufsize;
}

// ── Public init ───────────────────────────────────────────────
//  Call once in setup(), before hidBegin().

void mscBegin() {
  const uint32_t img_bytes = MSC_IMAGE_SECTORS * MSC_BLOCK_SIZE;

  // Prefer PSRAM (8 MB available on Waveshare board).
  // 256 KB is negligible compared to the total PSRAM.
  msc_ram = (uint8_t *)ps_malloc(img_bytes);
  if (!msc_ram) {
    // Fallback: internal SRAM (uses ~256 KB — tight but possible)
    msc_ram = (uint8_t *)malloc(img_bytes);
  }
  if (!msc_ram) {
    Serial.println("ERR mscBegin: malloc failed");
    return;
  }

  // Stamp the baked-in image into the working RAM copy.
  // MSC_IMAGE[] is in flash (read-only); memcpy works because
  // ESP32 flash is memory-mapped.
  memcpy(msc_ram, MSC_IMAGE, img_bytes);

  MSC.vendorID("HMS");
  MSC.productID("RigSetup");
  MSC.productRevision("1.0");
  MSC.onRead(on_msc_read);
  MSC.onWrite(on_msc_write);
  // onFlush() does not exist in ESP32 core 3.x — omitted.
  msc_img_bytes = img_bytes;
  MSC.mediaPresent(false);   // disk hidden; mscInsert() makes it visible
  MSC.begin(MSC_IMAGE_SECTORS, MSC_BLOCK_SIZE);
  // Note: USB.begin() is called later in hidBegin()
}

// ── Media insert / eject  (called from hid.ino) ───────────────
//
//  mscInsert()  Resets the RAM copy to the baked-in image so the
//               Pi always sees a clean disk, then signals the host
//               that media has been inserted (SCSI Unit Attention).
//               Call at the start of hidInstallOnPi().
//
//  mscEject()   Signals the host that media has been removed.
//               Call at every exit point of hidInstallOnPi().

void mscInsert() {
  if (msc_ram && msc_img_bytes)
    memcpy(msc_ram, MSC_IMAGE, msc_img_bytes);  // fresh image each time
  MSC.mediaPresent(true);
}

void mscEject() {
  MSC.mediaPresent(false);
}
