{
  "macros": [
    {"id":  1, "name": "Show network interfaces",  "cmd": "ip a",                                                                                    "cr": true},
    {"id":  2, "name": "Show routing table",        "cmd": "ip route show",                                                                           "cr": true},
    {"id":  3, "name": "Show ARP table",            "cmd": "arp -n",                                                                                  "cr": true},
    {"id":  4, "name": "Ping gateway",              "cmd": "ping -c 4 $(ip route | awk '/default/{print $3; exit}')",                                 "cr": true},
    {"id":  5, "name": "Show external IP",            "cmd": "curl -s ifconfig.me && echo",                                                             "cr": true},
    {"id":  6, "name": "Show open ports",         "cmd": "ss -tulnp",                                                                               "cr": true},
    {"id":  7, "name": "Hostname + IP",             "cmd": "echo \"Host: $(hostname)  IP: $(hostname -I)\"",                                          "cr": true},
    {"id":  8, "name": "Ping 8.8.8.8",             "cmd": "ping -c 4 8.8.8.8",                                                                       "cr": true},

    {"id":  9, "name": "Scan WiFi",               "cmd": "sudo iwlist wlan0 scan | grep -E 'ESSID|Signal level|Frequency'",                         "cr": true},
    {"id": 10, "name": "List WiFi networks",        "cmd": "nmcli dev wifi list",                                                                     "cr": true},
    {"id": 11, "name": "WiFi interface info",        "cmd": "iwconfig wlan0 2>/dev/null || echo 'wlan0 not found'",                                    "cr": true},
    {"id": 12, "name": "WiFi signal strength",         "cmd": "cat /proc/net/wireless",                                                                  "cr": true},
    {"id": 13, "name": "WiFi active connection profile",   "cmd": "nmcli con show --active",                                                                 "cr": true},

    {"id": 14, "name": "Top CPU processes",        "cmd": "ps aux --sort=-%cpu | head -16",                                                          "cr": true},
    {"id": 15, "name": "Top RAM processes",        "cmd": "ps aux --sort=-%mem | head -16",                                                          "cr": true},
    {"id": 16, "name": "Process tree",               "cmd": "pstree -p | head -40",                                                                    "cr": true},
    {"id": 17, "name": "Show memory",                "cmd": "free -h",                                                                                 "cr": true},
    {"id": 18, "name": "Show swap",                 "cmd": "swapon --show; free -h | tail -1",                                                        "cr": true},
    {"id": 19, "name": "Systemd failures",               "cmd": "systemctl --failed",                                                                      "cr": true},
    {"id": 20, "name": "Last 30 log lines",      "cmd": "journalctl -n 30 --no-pager",                                                             "cr": true},
    {"id": 21, "name": "Kernel log USB/serial",   "cmd": "dmesg | grep -iE 'usb|tty' | tail -20",                                                   "cr": true},

    {"id": 22, "name": "Disk usage",               "cmd": "df -h",                                                                                   "cr": true},
    {"id": 23, "name": "Home directory size",         "cmd": "du -sh /home/* 2>/dev/null",                                                              "cr": true},
    {"id": 24, "name": "Uptime",                  "cmd": "uptime",                                                                                  "cr": true},
    {"id": 25, "name": "Kernel info",               "cmd": "uname -a",                                                                                "cr": true},
    {"id": 26, "name": "RPi model",                "cmd": "cat /proc/cpuinfo | grep -m1 Model",                                                      "cr": true},
    {"id": 27, "name": "CPU temperature",            "cmd": "vcgencmd measure_temp 2>/dev/null || awk '{printf \"%.1f C\\n\",$1/1000}' /sys/class/thermal/thermal_zone0/temp", "cr": true},
    {"id": 28, "name": "CPU throttling",            "cmd": "vcgencmd get_throttled 2>/dev/null || echo 'vcgencmd not available'",                   "cr": true},
    {"id": 29, "name": "Logged in users",       "cmd": "who",                                                                                     "cr": true},
    {"id": 30, "name": "Login history",       "cmd": "last | head -10",                                                                         "cr": true},

    {"id": 31, "name": "List USB devices",         "cmd": "lsusb",                                                                                   "cr": true},
    {"id": 32, "name": "USB tree view",                "cmd": "lsusb -t",                                                                                "cr": true},
    {"id": 33, "name": "USB dmesg log",                 "cmd": "dmesg | grep -i usb | tail -20",                                                          "cr": true},
    {"id": 34, "name": "Show serial ports",      "cmd": "ls /dev/ttyUSB* /dev/ttyACM* /dev/ttyS* 2>/dev/null || echo 'No serial devices'",     "cr": true},
    {"id": 35, "name": "Block devices (disk+USB)",   "cmd": "lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT | grep -v loop",                                "cr": true},
    {"id": 36, "name": "Mounted filesystems",       "cmd": "mount | grep -v 'tmpfs\\|devtmpfs\\|sysfs\\|proc\\|cgroup\\|mqueue\\|debugfs'",           "cr": true},

    {"id": 37, "name": "Update package list",      "cmd": "sudo apt update",                                                                         "cr": true},
    {"id": 38, "name": "Upgradable packages",   "cmd": "apt list --upgradable 2>/dev/null | head -20",                                            "cr": true},
    {"id": 39, "name": "Install package [TEMPLATE]",   "cmd": "sudo apt install -y <PACKAGENAME>",                                                         "cr": false},
    {"id": 40, "name": "Remove package [TEMPLATE]",      "cmd": "sudo apt remove <PACKAGENAME>",                                                             "cr": false},

    {"id": 41, "name": "Set static IP [TEMPLATE]",    "cmd": "sudo ip addr add <IP/PREFIX> dev <INTERFACE>",                                            "cr": false},
    {"id": 42, "name": "Remove IP [TEMPLATE]",         "cmd": "sudo ip addr del <IP/PREFIX> dev <INTERFACE>",                                            "cr": false},
    {"id": 43, "name": "Set default gateway [TEMPLATE]","cmd": "sudo ip route add default via <GATEWAY_IP>",                                             "cr": false},
    {"id": 44, "name": "Restart NetworkManager",  "cmd": "sudo systemctl restart NetworkManager",                                                   "cr": true},
    {"id": 45, "name": "Restart networking",      "cmd": "sudo systemctl restart networking",                                                        "cr": true},
    {"id": 46, "name": "nmcli set IP [TEMPLATE]",      "cmd": "sudo nmcli con mod '<PROFILE>' ipv4.addresses <IP/PREFIX> ipv4.method manual",             "cr": false},
    {"id": 47, "name": "nmcli activate profile [TEMPLATE]","cmd": "sudo nmcli con up '<PROFILE>'",                                                          "cr": false},

    {"id": 48, "name": "Reboot Pi",              "cmd": "sudo reboot",                                                                             "cr": false},
    {"id": 49, "name": "Shutdown Pi",               "cmd": "sudo poweroff",                                                                           "cr": false},
    {"id": 50, "name": "Systemd service status [TEMPLATE]","cmd": "systemctl status <SERVICE>",                                                             "cr": false},
    {"id": 51, "name": "Start service [TEMPLATE]",      "cmd": "sudo systemctl start <SERVICE>",                                                           "cr": false},
    {"id": 52, "name": "Restart service [TEMPLATE]",   "cmd": "sudo systemctl restart <SERVICE>",                                                         "cr": false},
    {"id": 53, "name": "SSH to host [TEMPLATE]",      "cmd": "ssh <USER>@<HOST>",                                                                  "cr": false},
    {"id": 54, "name": "Copy file SCP [TEMPLATE]",    "cmd": "scp <FILE> <USER>@<HOST>:<PATH>",                                                   "cr": false},
    {"id": 55, "name": "Python3 version",           "cmd": "python3 --version",                                                                       "cr": true},
    {"id": 56, "name": "pip list installed",    "cmd": "pip3 list 2>/dev/null | head -20",                                                        "cr": true},
    {"id": 57, "name": "I2C scan",              "cmd": "i2cdetect -y 1",                                                                          "cr": true},
    {"id": 58, "name": "GPIO status (raspi-gpio)",  "cmd": "raspi-gpio get 2>/dev/null || echo 'raspi-gpio not installed'",                          "cr": true}
  ],
  "nextId": 59
}
